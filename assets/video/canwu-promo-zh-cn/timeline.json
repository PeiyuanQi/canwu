  "subtitles": [
    { "start": 4.9, "end": 7.2, "text": "历史上，没有人能看见全局。" },
    { "start": 7.2, "end": 9.9, "text": "消息会迟到，报告也可能出错。" },
    { "start": 10.4, "end": 14.2, "text": "参伍引擎：用 Rust 构建可重放的历史模拟。" },
    { "start": 14.7, "end": 17.8, "text": "参伍是一个无界面历史模拟引擎。" },
    { "start": 17.8, "end": 20.9, "text": "它负责推进时间、验证命令、记录因果。" },
    { "start": 20.9, "end": 23.9, "text": "画面、界面和历史内容，交给你的应用。" },
    { "start": 24.4, "end": 28.9, "text": "时间、调度工作与随机抽样，都按固定顺序执行。" },
    { "start": 28.9, "end": 33.4, "text": "读档、派生分支、重放，检查点哈希都与原运行一致。" },
    { "start": 34.0, "end": 38.5, "text": "世界的真实状态与角色知识分开保存。" },
    { "start": 38.5, "end": 43.0, "text": "角色依据自己掌握的信息行事，哪怕它迟到或有误。" },
    { "start": 43.6, "end": 48.1, "text": "客户端只能用命令改变世界，并经类型与权限校验。" },
    { "start": 48.1, "end": 52.6, "text": "每个结算边界要么全部提交，要么完整回滚。" },
    { "start": 53.2, "end": 57.7, "text": "每个事件都记录它为何发生。" },
    { "start": 57.7, "end": 62.2, "text": "每个结果，都能沿因果链追溯到起因。" },
    { "start": 62.8, "end": 67.3, "text": "模拟内核没有内置任何时代或地图，" },
    { "start": 67.3, "end": 71.8, "text": "规则由插件定义，扩展按需组合。" },
    { "start": 72.4, "end": 76.9, "text": "AI 智能体与玩家使用同一套 API，" },
    { "start": 76.9, "end": 81.4, "text": "只读取自己角色的视图，提交同样的命令。" },
    { "start": 82.0, "end": 86.4, "text": "第一步：在 Cargo.toml 中添加 canwu-api。" },
    { "start": 86.4, "end": 91.0, "text": "第二步：在参伍仓库中运行 starter 示例，仓库地址见 canwu.org。" },
    { "start": 91.6, "end": 94.9, "text": "还可以让编码智能体调用官方技能，" },
    { "start": 94.9, "end": 98.2, "text": "快速搭建游戏或历史模拟。" },
    { "start": 98.8, "end": 103.3, "text": "游戏、研究、教学与智能体，都能用它来构建。" },
    { "start": 103.3, "end": 107.8, "text": "Apache 2.0 开源，商业使用免版税。" },
    { "start": 108.6, "end": 112.6, "text": "参伍引擎：构建可重放的历史模拟。" },
    { "start": 112.6, "end": 116.8, "text": "访问 canwu.org，开始你的第一次模拟。" }
  ]
}
