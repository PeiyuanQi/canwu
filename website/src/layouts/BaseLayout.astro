---
import "../styles/global.css";
import GitHubIcon from "../components/GitHubIcon.astro";

interface Props {
  title: string;
  description: string;
  locale?: "zh-CN" | "en" | "auto";
  zhPath?: string;
  enPath?: string;
}

const {
  title,
  description,
  locale = "en",
  zhPath = "/",
  enPath = "/en/",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const isAuto = locale === "auto";
const documentLocale = locale === "en" ? "en" : "zh-CN";
const isEnglish = documentLocale === "en";

const ui = {
  en: {
    skip: "Skip to content",
    homeLabel: "Canwu home",
    navLabel: "Primary navigation",
    docs: "Docs",
    quickstart: "Get Started",
    architecture: "Architecture",
    integrations: "Integrations",
    contribute: "Contribute",
    credits: "Credits",
    issues: "Issues",
    examples: "Examples",
    license: "License",
    menu: "Menu",
    language: "中文",
    footerLine: "A deterministic historical simulation core written in Rust, embeddable in any client.",
    footerSub: "Open source · Rust · Windows / macOS / Linux",
  },
  zh: {
    skip: "跳到正文",
    homeLabel: "参伍引擎首页",
    navLabel: "主导航",
    docs: "文档",
    quickstart: "快速开始",
    architecture: "架构",
    integrations: "集成",
    contribute: "参与贡献",
    credits: "鸣谢",
    issues: "议题",
    examples: "示例",
    license: "许可证",
    menu: "菜单",
    language: "EN",
    footerLine: "用 Rust 构建的确定性历史模拟内核，可嵌入任意客户端。",
    footerSub: "开源 · Rust · Windows / macOS / Linux",
  },
};

const variants = isAuto
  ? [
      { locale: "zh-CN" as const, ui: ui.zh, prefix: "", languageHref: "/en/" },
      { locale: "en" as const, ui: ui.en, prefix: "/en", languageHref: "/" },
    ]
  : [{ locale: documentLocale, ui: isEnglish ? ui.en : ui.zh, prefix: isEnglish ? "/en" : "", languageHref: isEnglish ? zhPath : enPath }];

const navItems = (variant: typeof variants[number]) => [
  { href: "https://github.com/PeiyuanQi/canwu/tree/main/docs", label: variant.ui.docs },
  { href: `${variant.prefix}/#quickstart`, label: variant.ui.quickstart },
  { href: `${variant.prefix}/#architecture`, label: variant.ui.architecture },
  { href: `${variant.prefix}/showcase/`, label: variant.ui.integrations },
  { href: "https://github.com/PeiyuanQi/canwu/blob/main/CONTRIBUTING.md", label: variant.ui.contribute },
];
---

<!doctype html>
<html lang={documentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11100d" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(zhPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(zhPath, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/brand/canwu-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/canwu-mark-32.png" />
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Canwu Engine" />
    <meta property="og:locale" content={isEnglish ? "en_US" : "zh_CN"} />
    <meta property="og:locale:alternate" content={isEnglish ? "zh_CN" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/brand/canwu-mark.png", Astro.site)} />
    <meta property="og:image:alt" content="Canwu circular 35 mark" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/brand/canwu-mark.png", Astro.site)} />
    <title>{title}</title>
    {isAuto && <script is:inline>
      const englishPath = location.pathname === "/en" || location.pathname.startsWith("/en/");
      document.documentElement.dataset.locale = englishPath ? "en" : "zh-CN";
      document.documentElement.lang = englishPath ? "en" : "zh-CN";
    </script>}
  </head>
  <body>
    {variants.map((variant) => <a class="skip-link" data-locale-content={isAuto ? variant.locale : undefined} href="#content">{variant.ui.skip}</a>)}
    <header class="site-header">
      {variants.map((variant) => (
        <a class="brand" data-locale-content={isAuto ? variant.locale : undefined} href={variant.locale === "en" ? "/en/" : "/"} aria-label={variant.ui.homeLabel}>
          <img src="/brand/canwu-mark.svg" width="48" height="48" alt="" />
          <span><b>参伍引擎</b><small>Canwu Engine</small></span>
        </a>
      ))}
      {variants.map((variant) => (
        <nav data-locale-content={isAuto ? variant.locale : undefined} aria-label={variant.ui.navLabel}>
          {navItems(variant).map((item) => <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a>)}
          <a class="language-switch" href={variant.languageHref} hreflang={variant.locale === "en" ? "zh-CN" : "en"}>{variant.ui.language}</a>
          <a class="nav-github github-link" href="https://github.com/PeiyuanQi/canwu"><GitHubIcon />GitHub</a>
        </nav>
      ))}
      {variants.map((variant) => (
        <details class="mobile-menu" data-locale-content={isAuto ? variant.locale : undefined}>
          <summary>{variant.ui.menu}</summary>
          <div>
            {navItems(variant).map((item) => <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a>)}
            <a href={variant.languageHref} hreflang={variant.locale === "en" ? "zh-CN" : "en"}>{variant.ui.language}</a>
            <a class="github-link" href="https://github.com/PeiyuanQi/canwu"><GitHubIcon />GitHub</a>
          </div>
        </details>
      ))}
    </header>
    <main id="content"><slot /></main>
    {variants.map((variant) => (
      <footer class="site-footer" data-locale-content={isAuto ? variant.locale : undefined}>
        <div>
          <p class="footer-mark"><span>参伍引擎</span> {variant.ui.footerLine}</p>
          <p>{variant.ui.footerSub}</p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/PeiyuanQi/canwu/tree/main/docs">{variant.ui.docs} ↗</a>
          <a href="https://github.com/PeiyuanQi/canwu/tree/main/crates/canwu-api/examples">{variant.ui.examples} ↗</a>
          <a href="https://github.com/PeiyuanQi/canwu/blob/main/CONTRIBUTING.md">{variant.ui.contribute} ↗</a>
          <a href="https://github.com/PeiyuanQi/canwu/issues">{variant.ui.issues} ↗</a>
          <a href="https://github.com/PeiyuanQi/canwu/blob/main/LICENSE">{variant.ui.license} ↗</a>
          <a href={`${variant.prefix}/credits/`}>{variant.ui.credits}</a>
          <a href={variant.languageHref} hreflang={variant.locale === "en" ? "zh-CN" : "en"}>{variant.ui.language}</a>
          <a class="github-link" href="https://github.com/PeiyuanQi/canwu"><GitHubIcon />GitHub</a>
        </div>
      </footer>
    ))}
  </body>
</html>
