---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props { locale: "zh-CN" | "en"; }
const { locale } = Astro.props;
const isEnglish = locale === "en";
const prefix = isEnglish ? "/en" : "";

const rustExample = `use canwu_api::{Canwu, ObserveRequest, SemanticAction, SimDuration};

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut canwu = Canwu::demo(35)?;
    let ids = Canwu::demo_ids();

    canwu.act(
        ids.commander,
        SemanticAction::MoveArmy {
            army: ids.army,
            destination: ids.eastern_territory,
        },
    )?;
    let arrival_events = canwu.advance(SimDuration::days(1))?;

    let commander = canwu.observe(ids.commander, &ObserveRequest::default())?;
    let observer = canwu.observe(ids.observer, &ObserveRequest::default())?;
    println!("time: {}", canwu.time());
    println!("arrival events: {}", arrival_events.len());
    println!(
        "commander knows location: {:?}",
        commander.known_armies[0].known_location
    );
    println!(
        "observer still believes location: {:?}",
        observer.known_armies[0].known_location
    );

    canwu.advance(SimDuration::days(3))?;
    let observer = canwu.observe(ids.observer, &ObserveRequest::default())?;
    println!(
        "observer after report: {:?}",
        observer.known_armies[0].known_location
    );
    Ok(())
}`;

const cliExample = `git clone https://github.com/PeiyuanQi/canwu
cd canwu
cargo run -p canwu-api --example move_army`;

const outputExample = `time: Day 1, 00:00
arrival events: 3
commander knows location: Some(TerritoryId(3))
observer still believes location: Some(TerritoryId(2))
observer after report: Some(TerritoryId(3))`;

const agentFlow = `observe(actor)
  → available_actions(actor)
  → act(actor, semantic_action)
  → explain(event)`;

