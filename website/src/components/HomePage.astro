---

<BaseLayout title={c.title} description={c.description} locale={locale} zhPath="/" enPath="/en/">
  <section class="tech-hero page-width">
    <div class="hero-project">
      <p class="version-line"><span></span>{c.status}</p>
      <div class="hero-title"><img src="/brand/canwu-mark.svg" width="112" height="112" alt="" /><div><h1>{c.name}</h1><p>{c.nativeName}</p></div></div>
      <h2>{c.summary}</h2><p class="hero-intro">{c.intro}</p>
      <div class="action-row"><a class="button primary" href="#quickstart">{c.getStarted}</a><a class="button" href="https://github.com/PeiyuanQi/canwu">{c.repository} ↗</a><a class="text-action" href={`${prefix}/architecture/`}>{c.docs} →</a></div>
      <dl class="fact-row">{c.facts.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl>
    </div>
    <div class="hero-evidence"><div class="code-panel hero-code"><div class="code-title"><span>{c.example}</span><code>starter.rs</code></div><pre><code>{rustExample}</code></pre></div><a href="https://github.com/PeiyuanQi/canwu/blob/main/crates/integrations/canwu-reference-world/examples/starter.rs">{c.source} ↗</a></div>
  </section>

  <section class="install-section page-width" id="install">
    <div class="install-copy"><p>{c.installLabel}</p><h2>{c.installTitle}</h2><span>{c.installIntro}</span></div>
    <div class="install-actions"><div class="install-command"><span>{c.installCommandLabel}</span><code>{installCommand}</code></div><a class="button" href={releaseUrl}>{c.release} ↗</a></div>
  </section>

  <section class="tech-section page-width" id="features"><header class="section-heading"><p>{c.featuresLabel}</p><h2>{c.featuresTitle}</h2><span>{c.featuresIntro}</span></header><div class="feature-grid focused">{c.features.map(([key, title, copy]) => <article><code>{key}</code><h3>{title}</h3><p>{copy}</p></article>)}</div><aside class="scope-strip"><p>{c.scopeLabel}</p><div><h3>{c.scopeTitle}</h3><span>{c.scopeCopy}</span></div></aside></section>

  <section class="tech-section page-width" id="quickstart"><header class="section-heading"><p>{c.quickLabel}</p><h2>{c.quickTitle}</h2><span>{c.quickIntro}</span></header><div class="quick-grid"><div><h3>{c.clone}</h3><div class="code-panel command"><pre><code>{cliExample}</code></pre></div><h3 class="output-heading">{c.output}</h3><div class="code-panel output"><pre><code>{outputExample}</code></pre></div><a class="button quick-tutorial-link" href={`${prefix}/tutorials/move-army/`}>{c.quickTutorial}</a></div><aside class="status-box"><span>{c.status}</span><h3>{c.statusTitle}</h3><p>{c.statusCopy}</p><div class="status-columns"><div><h4>{c.availableTitle}</h4><ul class="technical-list">{c.availableItems.map((item) => <li>{item}</li>)}</ul></div><div><h4>{c.evolvingTitle}</h4><ul class="technical-list">{c.evolvingItems.map((item) => <li>{item}</li>)}</ul></div></div><p>{c.platforms}</p><a href="https://github.com/PeiyuanQi/canwu/blob/main/README.md">README ↗</a></aside></div></section>

  <section class="tech-section page-width" id="architecture"><header class="section-heading"><p>{c.architectureLabel}</p><h2>{c.architectureTitle}</h2><span>{c.architectureIntro}</span></header><div class="architecture-grid"><div class="architecture-diagram"><div class="arch-apps"><strong>{c.apps}</strong><div>{c.appItems.map((item) => <span>{item}</span>)}</div></div><div class="arch-arrow">↓</div><div class="arch-layer public"><code>{c.publicApi}</code><span>{c.publicDetails}</span></div><div class="arch-arrow">↓</div><div class="arch-layer runtime"><code>{c.sim}</code><span>{c.simDetails}</span></div><div class="arch-arrow">↓</div><div class="arch-layer foundation"><strong>{c.foundation}</strong><span>{c.foundationDetails}</span></div></div><div class="arch-notes"><ul class="technical-list">{c.archNotes.map((item) => <li>{item}</li>)}</ul><a class="button" href={`${prefix}/architecture/`}>{c.architectureLink}</a></div></div></section>

  <section class="tech-section page-width"><header class="section-heading"><p>{c.cratesLabel}</p><h2>{c.cratesTitle}</h2></header><div class="crate-grid">{c.crates.map(([name, copy]) => <article><code>{name}</code><p>{copy}</p></article>)}</div></section>

  <section class="tech-section page-width agent-api"><div><header class="section-heading"><p>{c.agentLabel}</p><h2>{c.agentTitle}</h2><span>{c.agentCopy}</span></header><div class="method-list">{c.agentMethods.map((method) => <code>{method}()</code>)}</div></div><div class="code-panel"><div class="code-title"><span>{c.agentFlowLabel}</span><code>actor-scoped</code></div><pre><code>{agentFlow}</code></pre></div></section>

  <section class="tech-section page-width"><header class="section-heading inline"><div><p>{c.usesLabel}</p><h2>{c.usesTitle}</h2></div><a href={`${prefix}/showcase/`}>{c.allUses}</a></header><div class="use-grid">{c.uses.map(([title, copy]) => <article><h3>{title}</h3><p>{copy}</p></article>)}</div></section>

  <section class="project-section page-width"><div><p>{c.projectLabel}</p><h2>{c.projectTitle}</h2><span>{c.projectCopy}</span><aside class="license-note"><strong>{c.licenseTitle}</strong><span>{c.licenseCopy}</span></aside></div><div class="project-links">{c.projectLinks.map(([label, url]) => <a href={url}>{label}<span>{url.startsWith("/") ? "→" : "↗"}</span></a>)}</div></section>
</BaseLayout>
