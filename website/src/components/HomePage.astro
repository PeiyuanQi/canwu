---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchitectureMap from "./ArchitectureMap.astro";
import starterSource from "../../../crates/integrations/canwu-reference-world/examples/starter.rs?raw";

interface Props { locale: "zh-CN" | "en"; }
const { locale } = Astro.props;
const isEnglish = locale === "en";
const prefix = isEnglish ? "/en" : "";
const installCommand = `[dependencies]
canwu-api = "=0.13.0"`;
const releaseUrl = "https://github.com/PeiyuanQi/canwu/releases";
const cratesUrl = "https://crates.io/crates/canwu-api";
const conformanceUrl = "https://github.com/PeiyuanQi/canwu/blob/main/docs/engine-conformance.md";

// Rendered from the real example so the home page cannot drift from the code.
const rustExample = starterSource.replace(/\r\n/g, "\n").trimEnd();

const cliExample = `git clone https://github.com/PeiyuanQi/canwu
cd canwu
cargo run -p canwu-reference-world --example starter`;

const outputExample = `army_location=3 checkpoint=dd9796a606983d02eafd3495df11b20bb8423cec33f96c0eaddc24e44e4e2de1`;

const agentFlow = isEnglish
  ? `// 1. Read what this character knows
let viewer = canwu.viewer_for_actor(actor)?;
let knowledge = viewer.query_knowledge(&query)?;

// 2. Decide, then submit a typed command
canwu.enqueue_command(time, priority, request)?;
canwu.advance_canonical(duration)?;

// 3. See what changed from this character's point of view
let changes = canwu.viewer_for_actor(actor)?.visible_changes_since(since);`
  : `// 1. 读取该角色知道的内容
let viewer = canwu.viewer_for_actor(actor)?;
let knowledge = viewer.query_knowledge(&query)?;

// 2. 作出决定，提交类型化命令
canwu.enqueue_command(time, priority, request)?;
canwu.advance_canonical(duration)?;

// 3. 查看该角色能看到的变化
let changes = canwu.viewer_for_actor(actor)?.visible_changes_since(since);`;

const c = isEnglish
  ? {
      title: "Canwu Engine — Replayable historical simulations in Rust",
      description: "A deterministic Rust engine for historical and strategy simulations. Clients change the world through validated commands, and each character sees only what it knows.",
      status: "open source · 0.13.0 · pre-1.0",
      name: "Canwu Engine", nativeName: "参伍引擎",
      summary: "Build replayable historical simulations where each player sees only what their character knows.",
      intro: "Canwu is a headless simulation engine written in Rust. Your code sends it commands; it advances time, records what happened and why, and tracks what each character knows. Rendering, UI, and historical content stay in your game, research tool, or agent system.",
      getStarted: "Run the example", repository: "View source", docs: "Read the architecture",
      facts: [["Replay", "Same inputs, same result"], ["Knowledge", "A separate view per character"], ["Rendering", "Use any engine or UI"], ["Agents", "Same API as players"]],
      example: "The starter example", source: "Open starter.rs on GitHub",
      architectureLabel: "Architecture", architectureTitle: "How Canwu fits into your application", architectureIntro: "Your application sits on top and talks only to canwu-api. Domain plugins add rules such as resources, movement, or law. The runtime underneath holds the live world and changes it only while settling commands and scheduled work. Select a layer, or follow one command from submission to replay.",
      architectureLink: "Read the architecture guide →",
      featuresLabel: "Guarantees", featuresTitle: "Three things the engine guarantees", featuresIntro: "The engine owns time, state, and history; your plugins own the rules of your period. The engine enforces these three properties for every client, and for every plugin that reads, writes, and draws randomness only through its declared contract.",
      features: [
        ["replay", "Deterministic replay", "Time, scheduled work, and random draws run in a fixed order. Replaying a run's journal rebuilds it, and the checkpoint hash confirms the result is identical."],
        ["knowledge", "Each character knows different things", "The true state of the world is kept apart from what each character knows. Each observation records its source, confidence, and age, so a character can act on a report that is late or wrong."],
        ["commands", "One API for every client", "Clients change the world only by submitting commands, and read it through snapshots, events, or a character's view. A game, a research notebook, and an AI agent use the same calls."],
      ],
      scopeLabel: "Scope", scopeTitle: "Any period, region, or renderer", scopeCopy: "The core has no built-in period or map. Scenario data and plugins define institutions, geography, population, trade, and conflict. The repository includes reusable extensions for resources, production, movement, military operations, fiscal procedure, technology, information and correspondence, social diffusion, culture, and law (experimental).",
      installLabel: "Install", installTitle: "Add canwu-api 0.13.0", installIntro: "Requires Rust 1.88 or newer. Add canwu-api to your application's Cargo.toml. The reference world used by the examples lives in the repository; clone it to run the examples. The exact = pin matters because a save loads only in the engine version that wrote it.", installCommandLabel: "Cargo.toml", release: "View releases",
      quickLabel: "Five-minute check", quickTitle: "Run the starter example", quickIntro: "The starter moves an army with a typed command and advances 19 hours. It then saves and reloads, forks, and replays the run, and checks that all three copies match the original's checkpoint hash.",
      clone: "Clone and run", output: "Expected output", quickTutorial: "Step-by-step tutorial",
      statusTitle: "What works today", statusCopy: "Canwu is pre-1.0, so a minor version can still change the API. Everything listed under “Implemented” has tests. Before you depend on an area that is still in progress, check the conformance profile.",
      availableTitle: "Implemented", availableItems: ["Change state only through validated commands, built into the engine or defined by your plugins", "Advance time, run scheduled work, and record the cause of every event", "Give each character its own knowledge, including late reports", "Save snapshots and checkpoint journals, fork runs, and replay them exactly", "Track whether each person is alive, free, detained, or captive, and reject orders from people who cannot act", "Check a change that spans several plugins before it commits", "Show rule explanations only to characters allowed to see them", "Move goods and people with capacity limits, delegated carriers, and shared access to resources (extension plugins)", "Checked-in benchmarks for run time, memory allocation, and snapshot size"],
      evolvingTitle: "In progress", evolvingItems: ["Bindings for other languages and network access", "Archive storage and indexed lookup of past history", "Larger runnable scenarios that combine several domains", "Ready-made client and renderer integrations"],
      platforms: "CI runs on Windows, macOS, and Linux.", conformance: "Conformance profile ↗",
      agentLabel: "AI agents", agentTitle: "Agents use the same API as players", agentCopy: "An agent reads a view limited to its character, submits the same typed commands a player would, and sees rule explanations only for what that character may know. Each domain plugin defines its own commands and views.", agentFlowLabel: "Agent loop",
      agentMethods: ["viewer_for_actor(actor)", "viewer.query_knowledge(query)", "viewer.visible_changes_since(time)", "viewer.evaluation_traces(subject, after)", "enqueue_command(...)", "advance_canonical(...)"],
      usesLabel: "Use cases", usesTitle: "What you can build", uses: [["Grand strategy games", "Run the simulation behind any map or renderer."], ["Historical research", "Run repeatable scenarios, branch alternative histories, and compare the results."], ["Agent environments", "Give several agents different knowledge, authority, and commands."], ["Education and public history", "Build timelines, maps, and classroom tools on replayable state."]], allUses: "See integration patterns →",
      projectLabel: "Contribute", projectTitle: "Help improve Canwu", projectCopy: "Start with the architecture guide and the contribution guide, then open an issue or a focused pull request. Improvements to the public API, docs, tests, and reference scenarios are all welcome.",
      licenseTitle: "Open-source license", licenseCopy: "Canwu uses the Apache License 2.0. You may use, modify, and redistribute it in commercial and proprietary products without royalties; include the license and NOTICE files with the copies you distribute.",
      projectLinks: [["Architecture", "/en/architecture/"], ["API examples", "https://github.com/PeiyuanQi/canwu/tree/main/crates/api/canwu-api/examples"], ["Contributing", "https://github.com/PeiyuanQi/canwu/blob/main/CONTRIBUTING.md"], ["License", "/LICENSE"]],
    }
  : {
      title: "参伍引擎 — 用 Rust 构建可重放的历史模拟",
      description: "用于历史与策略模拟的确定性 Rust 引擎。客户端通过经过验证的命令改变世界，每个角色只看到自己知道的内容。",
      status: "开源 · 0.13.0 · 尚未到 1.0",
      name: "参伍引擎", nativeName: "Canwu Engine",
      summary: "构建可重放的历史模拟，让每个玩家只看到自己角色知道的世界。",
      intro: "参伍是用 Rust 编写的无界面模拟引擎。你的代码向它提交命令，它负责推进时间、记录发生了什么以及原因，并跟踪每个角色知道什么。渲染、界面和历史内容仍由你的游戏、研究工具或智能体系统负责。",
      getStarted: "运行示例", repository: "查看源码", docs: "阅读架构",
      facts: [["重放", "相同输入，相同结果"], ["知识", "每个角色一份视图"], ["渲染", "任选引擎或界面"], ["智能体", "与玩家共用 API"]],
      example: "starter 示例", source: "在 GitHub 打开 starter.rs",
      architectureLabel: "架构", architectureTitle: "参伍在你的应用中的位置", architectureIntro: "上层应用在最上层，只与 canwu-api 交互。领域插件提供资源、移动、法律等规则。下方的运行时持有实时世界状态，只在结算命令和调度工作时修改它。你可以逐层查看，也可以跟随一条命令，从提交一路看到重放。",
      architectureLink: "阅读架构指南 →",
      featuresLabel: "设计保证", featuresTitle: "引擎提供的三项保证", featuresIntro: "引擎负责时间、状态与历史，插件负责特定时代的规则。对所有客户端，以及只通过声明契约读写状态、抽取随机数的插件，下面三点都成立。",
      features: [
        ["replay", "确定性重放", "时间、调度工作和随机抽样都按固定顺序执行。根据重放日志可以重建一次模拟运行，检查点哈希用来确认结果完全一致。"],
        ["knowledge", "每个角色所知不同", "世界的真实状态与角色知识分开保存。每条观察都记录来源、可信度和信息时效，因此角色可能依据迟到或有误的报告行事。"],
        ["commands", "所有客户端共用一套 API", "客户端只通过提交命令改变世界，通过快照、事件或角色视图读取世界。游戏、研究笔记本和 AI 智能体调用的是同一组接口。"],
      ],
      scopeLabel: "适用范围", scopeTitle: "不限时代、地区与渲染器", scopeCopy: "内核没有内置任何时代或地图。制度、地理、人口、贸易和冲突都由场景数据和插件定义。仓库中提供可复用的资源、生产、移动、军事、财政程序、技术、信息与通信、社会传播、文化和法律（实验性）扩展。",
      installLabel: "安装", installTitle: "添加 canwu-api 0.13.0", installIntro: "需要 Rust 1.88 或更新版本。在应用的 Cargo.toml 中添加 canwu-api。示例使用的参考世界位于仓库中，克隆仓库即可运行示例。使用 = 精确锁定版本，是因为存档只能由写入它的引擎版本加载。", installCommandLabel: "Cargo.toml", release: "查看发布版本",
      quickLabel: "五分钟上手", quickTitle: "运行 starter 示例", quickIntro: "starter 用一条类型化命令让军队移动，并推进 19 小时。随后它对这次运行做存档与读档、派生分支和重放，并检查三份副本的检查点哈希都与原运行一致。",
      clone: "克隆并运行", output: "预期输出", quickTutorial: "查看分步教程",
      statusTitle: "目前可用的功能", statusCopy: "参伍仍处于 1.0 之前，次版本更新仍可能改变 API。“已实现”中列出的功能都有测试覆盖。依赖仍在推进的部分之前，请先查看契约符合性说明。",
      availableTitle: "已实现", availableItems: ["只通过经验证的引擎命令或插件命令修改状态", "推进时间、运行调度工作，并记录每个事件的起因", "为每个角色维护独立的知识，包括迟到的报告", "保存快照和检查点日志，派生分支，并精确重放", "记录每个人物是否存活、自由、被拘押或被俘，拒绝无法行事的人物发出的命令", "在跨越多个插件的变更提交前进行审计", "只向有权查看的角色展示规则说明", "通过扩展插件支持带运力上限的移动、受托承运人和资源动用授权", "仓库中附带运行时间、内存分配和快照大小的基准测试"],
      evolvingTitle: "仍在推进", evolvingItems: ["其他语言绑定与网络接口", "归档存储与历史索引查询", "组合多个领域的更大可运行场景", "现成的客户端与渲染器整合"],
      platforms: "持续集成覆盖 Windows、macOS 与 Linux。", conformance: "契约符合性说明 ↗",
      agentLabel: "AI 智能体", agentTitle: "智能体与玩家使用同一套 API", agentCopy: "智能体读取限定在其角色范围内的视图，提交与玩家相同的类型化命令，也只能看到该角色所知范围内的规则说明。每个领域插件定义自己的命令和视图。", agentFlowLabel: "智能体循环",
      agentMethods: ["viewer_for_actor(actor)", "viewer.query_knowledge(query)", "viewer.visible_changes_since(time)", "viewer.evaluation_traces(subject, after)", "enqueue_command(...)", "advance_canonical(...)"],
      usesLabel: "应用场景", usesTitle: "可以用它构建什么", uses: [["大战略游戏", "在任意地图或渲染器下运行模拟。"], ["历史研究", "运行可重复的场景，派生平行现实并比较结果。"], ["智能体环境", "为多个智能体提供不同的知识、权限与命令。"], ["教育与公众史学", "在可重放的状态之上构建时间线、地图与课堂工具。"]], allUses: "查看集成模式 →",
      projectLabel: "参与贡献", projectTitle: "一起完善参伍", projectCopy: "先阅读架构说明和贡献指南，再提交议题或范围明确的拉取请求。欢迎改进对外 API、文档、测试和参考场景。",
      licenseTitle: "开源许可证", licenseCopy: "参伍采用 Apache License 2.0。你可以在商业和专有产品中免版税地使用、修改和再分发参伍；分发副本时请附带许可证和 NOTICE 文件。",
      projectLinks: [["架构", "/architecture/"], ["API 示例", "https://github.com/PeiyuanQi/canwu/tree/main/crates/api/canwu-api/examples"], ["贡献指南", "https://github.com/PeiyuanQi/canwu/blob/main/CONTRIBUTING.md"], ["许可证", "/LICENSE"]],
    };
---

<BaseLayout title={c.title} description={c.description} locale={locale} zhPath="/" enPath="/en/">
  <section class="tech-hero page-width">
    <div class="hero-project">
      <p class="version-line"><span></span>{c.status}</p>
      <div class="hero-title"><img src="/brand/canwu-mark.svg" width="112" height="112" alt="" /><div><h1>{c.name}</h1><p>{c.nativeName}</p></div></div>
      <h2>{c.summary}</h2><p class="hero-intro">{c.intro}</p>
      <div class="action-row"><a class="button primary" href="#quickstart">{c.getStarted}</a><a class="button" href="https://github.com/PeiyuanQi/canwu">{c.repository} ↗</a><a class="text-action" href="#architecture">{c.docs} ↓</a></div>
      <dl class="fact-row">{c.facts.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl>
    </div>
    <div class="hero-evidence"><div class="code-panel hero-code"><div class="code-title"><span>{c.example}</span><code>starter.rs</code></div><pre><code>{rustExample}</code></pre></div><a href="https://github.com/PeiyuanQi/canwu/blob/main/crates/integrations/canwu-reference-world/examples/starter.rs">{c.source} ↗</a></div>
  </section>

  <section class="tech-section page-width" id="architecture"><header class="section-heading"><p>{c.architectureLabel}</p><h2>{c.architectureTitle}</h2><span>{c.architectureIntro}</span></header><ArchitectureMap locale={locale} /><a class="button arch-guide-link" href={`${prefix}/architecture/`}>{c.architectureLink}</a></section>

  <section class="tech-section page-width" id="features"><header class="section-heading"><p>{c.featuresLabel}</p><h2>{c.featuresTitle}</h2><span>{c.featuresIntro}</span></header><div class="feature-grid focused">{c.features.map(([key, title, copy]) => <article><code>{key}</code><h3>{title}</h3><p>{copy}</p></article>)}</div><aside class="scope-strip"><p>{c.scopeLabel}</p><div><h3>{c.scopeTitle}</h3><span>{c.scopeCopy}</span></div></aside></section>

  <section class="install-section page-width" id="install">
    <div class="install-copy"><p>{c.installLabel}</p><h2>{c.installTitle}</h2><span>{c.installIntro}</span></div>
    <div class="install-actions"><div class="install-command"><span>{c.installCommandLabel}</span><code>{installCommand}</code></div><div class="install-links"><a class="button" href={cratesUrl}>crates.io ↗</a><a class="button" href={releaseUrl}>{c.release} ↗</a></div></div>
  </section>

  <section class="tech-section page-width" id="quickstart"><header class="section-heading"><p>{c.quickLabel}</p><h2>{c.quickTitle}</h2><span>{c.quickIntro}</span></header><div class="quick-grid"><div><h3>{c.clone}</h3><div class="code-panel command"><pre><code>{cliExample}</code></pre></div><h3 class="output-heading">{c.output}</h3><div class="code-panel output"><pre><code>{outputExample}</code></pre></div><a class="button quick-tutorial-link" href={`${prefix}/tutorials/move-army/`}>{c.quickTutorial}</a></div><aside class="status-box"><span>{c.status}</span><h3>{c.statusTitle}</h3><p>{c.statusCopy}</p><div class="status-columns"><div><h4>{c.availableTitle}</h4><ul class="technical-list">{c.availableItems.map((item) => <li>{item}</li>)}</ul></div><div><h4>{c.evolvingTitle}</h4><ul class="technical-list">{c.evolvingItems.map((item) => <li>{item}</li>)}</ul></div></div><p>{c.platforms}</p><a href={conformanceUrl}>{c.conformance}</a></aside></div></section>

  <section class="tech-section page-width agent-api"><div><header class="section-heading"><p>{c.agentLabel}</p><h2>{c.agentTitle}</h2><span>{c.agentCopy}</span></header><div class="method-list">{c.agentMethods.map((method) => <code>{method}</code>)}</div></div><div class="code-panel"><div class="code-title"><span>{c.agentFlowLabel}</span><code>actor-scoped</code></div><pre><code>{agentFlow}</code></pre></div></section>

  <section class="tech-section page-width"><header class="section-heading inline"><div><p>{c.usesLabel}</p><h2>{c.usesTitle}</h2></div><a href={`${prefix}/showcase/`}>{c.allUses}</a></header><div class="use-grid">{c.uses.map(([title, copy]) => <article><h3>{title}</h3><p>{copy}</p></article>)}</div></section>

  <section class="project-section page-width"><div><p>{c.projectLabel}</p><h2>{c.projectTitle}</h2><span>{c.projectCopy}</span><aside class="license-note"><strong>{c.licenseTitle}</strong><span>{c.licenseCopy}</span></aside></div><div class="project-links">{c.projectLinks.map(([label, url]) => <a href={url}>{label}<span>{url.startsWith("/") ? "→" : "↗"}</span></a>)}</div></section>
</BaseLayout>
