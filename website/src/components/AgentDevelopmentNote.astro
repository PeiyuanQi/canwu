---
interface Props {
  locale?: "zh-CN" | "en";
}

const { locale = "zh-CN" } = Astro.props;
const isEnglish = locale === "en";

const copy = isEnglish
  ? {
      summary: "Using a coding agent? Start here",
      intro: "Canwu ships two skills for coding agents. Ask your agent to load them before it writes code:",
      docsSkill: "canwu-engine-docs",
      usageSkill: "canwu-engine-usage",
      tutorials: "Get started",
      developer: "guides",
      promptLabel: "Starter prompt",
      prompt: "Load the canwu-engine-docs and canwu-engine-usage skills. Read the Canwu tutorial, guide page, and example that match this task. Use only canwu-api, state the rule you must preserve before you edit, and run the example or a focused check when you are done.",
    }
  : {
      summary: "在用编程智能体？从这里开始",
      intro: "参伍为编程智能体提供了两个 skill。请让智能体在写代码前先加载它们：",
      docsSkill: "canwu-engine-docs",
      usageSkill: "canwu-engine-usage",
      tutorials: "快速开始",
      developer: "开发指南",
      promptLabel: "可以直接发送的提示",
      prompt: "请先加载 canwu-engine-docs 和 canwu-engine-usage 两个 skill，再阅读与本任务对应的参伍教程、开发指南页面和示例。只通过 canwu-api 实现；动手修改前先说明需要保持的约束；完成后运行示例或针对性检查。",
    };

const skillUrl = "https://github.com/PeiyuanQi/canwu/tree/main/agent-interface/plugins/canwu-engine/skills";
const docsSkillUrl = `${skillUrl}/canwu-engine-docs/SKILL.md`;
const usageSkillUrl = `${skillUrl}/canwu-engine-usage/SKILL.md`;
const prefix = isEnglish ? "/en" : "";
---

<details class="agent-development-note">
  <summary>
    <span class="agent-development-note-icon" aria-hidden="true">i</span>
    <span>{copy.summary}</span>
  </summary>
  <div class="agent-development-note-body">
    <p>
      {copy.intro}
      <a href={docsSkillUrl} target="_blank" rel="noreferrer"><code>{copy.docsSkill}</code></a>
      {isEnglish ? " and " : " 与 "}
      <a href={usageSkillUrl} target="_blank" rel="noreferrer"><code>{copy.usageSkill}</code></a>{isEnglish ? "." : "。"}
      {isEnglish ? " Then start with the " : "然后从"}
      <a href={`${prefix}/tutorials/`}>{copy.tutorials}</a>{isEnglish ? " and the relevant runnable example, and use the " : "和相关可运行示例入手，按需查阅"}
      <a href={`${prefix}/developer/`}>{copy.developer}</a>{isEnglish ? " as needed." : "。"}
    </p>
    <p class="agent-development-note-label">{copy.promptLabel}</p>
    <pre><code>{copy.prompt}</code></pre>
  </div>
</details>
