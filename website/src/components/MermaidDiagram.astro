---
interface Props {
  definition: string;
  label: string;
  diagramLoading?: string;
  sourceSummary?: string;
  sourceLoading?: string;
  noScriptMessage?: string;
  zoomable?: boolean;
  zoomControlsLabel?: string;
  zoomInLabel?: string;
  zoomOutLabel?: string;
  resetZoomLabel?: string;
}

const {
  definition,
  label,
  diagramLoading = "Rendering diagram…",
  sourceSummary = "View diagram source",
  sourceLoading = "Diagram source loads with the preview.",
  noScriptMessage = "JavaScript is required for the diagram preview; the text-source fallback remains available above.",
  zoomable = false,
  zoomControlsLabel = "Diagram zoom",
  zoomInLabel = "Zoom in",
  zoomOutLabel = "Zoom out",
  resetZoomLabel = "Reset zoom",
} = Astro.props;
const encodedDefinition = JSON.stringify(definition)
  .replaceAll("&", "\\u0026")
  .replaceAll("<", "\\u003c")
  .replaceAll(">", "\\u003e");
---

<figure class="mermaid-figure" data-zoomable={zoomable ? "true" : undefined}>
  <figcaption class="sr-only">{label}. {sourceSummary}.</figcaption>
  {zoomable && (
    <div class="mermaid-toolbar">
      <div class="mermaid-zoom-controls" role="group" aria-label={zoomControlsLabel}>
        <button type="button" data-mermaid-zoom-out aria-label={zoomOutLabel} title={zoomOutLabel}>-</button>
        <button type="button" data-mermaid-zoom-reset aria-label={`${resetZoomLabel}: 100%`} title={resetZoomLabel}>
          <span data-mermaid-zoom-level aria-live="polite">100%</span>
        </button>
        <button type="button" data-mermaid-zoom-in aria-label={zoomInLabel} title={zoomInLabel}>+</button>
      </div>
    </div>
  )}
  <div
    class="mermaid"
    role="img"
    aria-label={label}
    aria-busy="true"
    tabindex={zoomable ? "0" : undefined}
  >{diagramLoading}</div>
  <details class="mermaid-source">
    <summary>{sourceSummary}</summary>
    <pre><code class="mermaid-source-code">{sourceLoading}</code></pre>
  </details>
  <script is:inline type="application/json" class="mermaid-definition" set:html={encodedDefinition}></script>
  <noscript>
    <p class="mermaid-noscript">
      {noScriptMessage}
    </p>
  </noscript>
</figure>
