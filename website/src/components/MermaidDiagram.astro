---
interface Props {
  definition: string;
  label: string;
  diagramLoading?: string;
  sourceSummary?: string;
  noScriptMessage?: string;
  renderFailureMessage?: string;
  zoomable?: boolean;
  zoomControlsLabel?: string;
  zoomInLabel?: string;
  zoomOutLabel?: string;
  resetZoomLabel?: string;
  initialZoom?: number;
  minimumZoom?: number;
  maximumZoom?: number;
  zoomStep?: number;
}

const {
  definition,
  label,
  diagramLoading = "Rendering diagram…",
  sourceSummary = "View diagram source",
  noScriptMessage = "JavaScript is required for the diagram preview; the text-source fallback remains available above.",
  renderFailureMessage = "Diagram preview unavailable — source shown below.",
  zoomable = false,
  zoomControlsLabel = "Diagram zoom",
  zoomInLabel = "Zoom in",
  zoomOutLabel = "Zoom out",
  resetZoomLabel = "Reset zoom",
  initialZoom = 1,
  minimumZoom = 0.5,
  maximumZoom = 4,
  zoomStep = 0.25,
} = Astro.props;
const initialZoomPercentage = Math.round(initialZoom * 100);
const encodedDefinition = JSON.stringify(definition)
  .replaceAll("&", "\\u0026")
  .replaceAll("<", "\\u003c")
  .replaceAll(">", "\\u003e");
---

<figure
  class="mermaid-figure"
  data-zoomable={zoomable ? "true" : undefined}
  data-initial-zoom={zoomable ? initialZoom : undefined}
  data-minimum-zoom={zoomable ? minimumZoom : undefined}
  data-maximum-zoom={zoomable ? maximumZoom : undefined}
  data-zoom-step={zoomable ? zoomStep : undefined}
>
  <figcaption class="sr-only">{label}. {sourceSummary}.</figcaption>
  {zoomable && (
    <div class="mermaid-toolbar">
      <div class="mermaid-zoom-controls" role="group" aria-label={zoomControlsLabel}>
        <button type="button" data-mermaid-zoom-out aria-label={zoomOutLabel} title={zoomOutLabel}>-</button>
        <button type="button" data-mermaid-zoom-reset aria-label={`${resetZoomLabel}: ${initialZoomPercentage}%`} title={resetZoomLabel}>
          <span data-mermaid-zoom-level aria-live="polite">{initialZoomPercentage}%</span>
        </button>
        <button type="button" data-mermaid-zoom-in aria-label={zoomInLabel} title={zoomInLabel}>+</button>
      </div>
    </div>
  )}
  <div
    class="mermaid"
    role="img"
    aria-label={label}
    aria-busy="true"
    data-render-failure-message={renderFailureMessage}
    tabindex={zoomable ? "0" : undefined}
  >{diagramLoading}</div>
  <details class="mermaid-source">
    <summary>{sourceSummary}</summary>
    <pre><code class="mermaid-source-code">{definition}</code></pre>
  </details>
  <script is:inline type="application/json" class="mermaid-definition" set:html={encodedDefinition}></script>
  <noscript>
    <p class="mermaid-noscript">
      {noScriptMessage}
    </p>
  </noscript>
</figure>
