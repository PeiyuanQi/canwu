---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props { locale: "zh-CN" | "en"; }
const { locale } = Astro.props;
const isEnglish = locale === "en";

const c = isEnglish
  ? {
      title: "Canwu project and website information",
      description: "License, contribution, third-party, privacy, framework, and hosting information for Canwu and canwu.org.",
      label: "Project information", heading: "License, participation, and website credits",
      intro: "The engine and its website have different dependency boundaries. This page gives adopters and contributors direct access to the current license text, contribution rules, third-party notices, and website implementation details.",
      trust: [
        { title: "Engine license", status: "Source-available draft · not OSI-approved", copy: "Canwu License 1.0 is the current license text. Its legal-identity fields are not yet complete, so resolve those fields before relying on it for product distribution or commercialization.", links: [["Read LICENSE", "https://github.com/PeiyuanQi/canwu/blob/main/LICENSE"]] },
        { title: "Contributing", status: "Public repository", copy: "Development happens in public on GitHub. Review the architecture and contributor rules before proposing changes to simulation boundaries or public APIs.", links: [["Contribution guide", "https://github.com/PeiyuanQi/canwu/blob/main/CONTRIBUTING.md"], ["Repository", "https://github.com/PeiyuanQi/canwu"], ["Contributors", "https://github.com/PeiyuanQi/canwu/graphs/contributors"]] },
        { title: "Third-party software", status: "Repository notices", copy: "Engine and website dependencies retain their own licenses. The linked repository notices are the authoritative inventories; this page does not duplicate them.", links: [["Engine notices", "https://github.com/PeiyuanQi/canwu/blob/main/THIRD_PARTY_LICENSES.md"], ["Website notices", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"]] },
      ],
      privacyTitle: "Website privacy", privacy: ["No analytics or tracking pixels", "No cookies or local-storage identifiers", "No third-party hosted fonts", "No account system or user-submitted data"],
      stackLabel: "Website stack", stackTitle: "Built with Astro, hosted on GitHub Pages", stackIntro: "GitHub Actions builds the static site with Astro telemetry disabled. The complete dependency and license inventory lives in the linked repository notices.",
      sourceTitle: "Website source", sourceCopy: "Website source, build scripts, bilingual page components, and the full tool inventory are maintained in website/ inside the main repository.",
      brandTitle: "Brand assets", brandCopy: "The site uses the official Canwu 35 mark documented in BRANDING.md. Page diagrams and code panels are implemented with semantic HTML and CSS.",
      links: [["Website source", "https://github.com/PeiyuanQi/canwu/tree/main/website"], ["Website notices", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"], ["Brand guide", "https://github.com/PeiyuanQi/canwu/blob/main/BRANDING.md"]],
    }
  : {
      title: "参伍项目与网站说明",
      description: "参伍与 canwu.org 的许可证、贡献、第三方软件、隐私、框架与托管说明。",
      label: "项目信息", heading: "许可、参与方式与网站鸣谢",
      intro: "参伍引擎与网站具有不同的依赖边界。本页为采用者和贡献者提供当前许可证文本、贡献规则、第三方声明与网站实现信息的直接入口。",
      trust: [
        { title: "引擎许可证", status: "源码可用草案 · 非 OSI 认可", copy: "Canwu License 1.0 是当前许可证文本，其中的法律主体字段尚未完整。在依赖该许可证分发产品或开展商业使用前，需要先解决这些字段。", links: [["阅读 LICENSE", "https://github.com/PeiyuanQi/canwu/blob/main/LICENSE"]] },
        { title: "参与贡献", status: "公开仓库", copy: "开发工作在 GitHub 公开进行。提出涉及模拟边界或公开 API 的变更前，请先了解项目架构与贡献规则。", links: [["贡献指南", "https://github.com/PeiyuanQi/canwu/blob/main/CONTRIBUTING.md"], ["代码仓库", "https://github.com/PeiyuanQi/canwu"], ["贡献者", "https://github.com/PeiyuanQi/canwu/graphs/contributors"]] },
        { title: "第三方软件", status: "仓库声明", copy: "引擎与网站依赖继续使用各自许可证。链接的仓库声明是权威清单，本页不再重复逐项展示。", links: [["引擎声明", "https://github.com/PeiyuanQi/canwu/blob/main/THIRD_PARTY_LICENSES.md"], ["网站声明", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"]] },
      ],
      privacyTitle: "网站隐私", privacy: ["无分析统计或跟踪像素", "无 Cookie 或本地存储标识符", "无第三方托管字体", "无账号系统，也不收集用户提交数据"],
      stackLabel: "网站技术栈", stackTitle: "由 Astro 构建，托管于 GitHub Pages", stackIntro: "GitHub Actions 在关闭 Astro 遥测的情况下构建静态网站。完整依赖与许可证清单以链接的仓库声明为准。",
      sourceTitle: "网站源码", sourceCopy: "网站源码、构建脚本、中英文页面组件与完整工具清单均维护在主仓库的 website/ 目录中。",
      brandTitle: "品牌资产", brandCopy: "网站使用 BRANDING.md 中记录的官方参伍 35 标志。页面图表与代码面板由语义化 HTML 和 CSS 实现。",
      links: [["网站源码", "https://github.com/PeiyuanQi/canwu/tree/main/website"], ["网站声明", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"], ["品牌指南", "https://github.com/PeiyuanQi/canwu/blob/main/BRANDING.md"]],
    };
---

<BaseLayout title={c.title} description={c.description} locale={locale} zhPath="/credits/" enPath="/en/credits/">
  <section class="reference-hero page-width"><p>{c.label}</p><h1>{c.heading}</h1><span>{c.intro}</span></section>
  <section class="trust-grid page-width">{c.trust.map((item) => <article><code>{item.status}</code><h2>{item.title}</h2><p>{item.copy}</p><div class="reference-links">{item.links.map(([label, url]) => <a href={url}>{label} ↗</a>)}</div></article>)}</section>
  <section class="privacy-section page-width"><header><p>{c.privacyTitle}</p></header><ul class="technical-list">{c.privacy.map((item) => <li>{item}</li>)}</ul></section>
  <section class="stack-intro page-width"><p>{c.stackLabel}</p><h2>{c.stackTitle}</h2><span>{c.stackIntro}</span></section>
  <section class="implementation-grid page-width"><article><h2>{c.sourceTitle}</h2><p>{c.sourceCopy}</p><div class="reference-links">{c.links.map(([label, url]) => <a href={url}>{label} ↗</a>)}</div></article><article><h2>{c.brandTitle}</h2><p>{c.brandCopy}</p></article></section>
</BaseLayout>
