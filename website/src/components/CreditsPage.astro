---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props { locale: "zh-CN" | "en"; }
const { locale } = Astro.props;
const isEnglish = locale === "en";

const c = isEnglish
  ? {
      title: "Canwu project and website information",
      description: "License, contribution, third-party software, privacy, and project information for Canwu and canwu.org.",
      label: "Project information", heading: "License, participation, and website credits",
      intro: "The engine and its website have different dependency boundaries. This page gives adopters and contributors direct access to the current license text, contribution rules, third-party notices, and website implementation details.",
      trust: [
        { title: "Engine license", status: "Open source · Apache-2.0", copy: "Canwu supports royalty-free use, modification, and redistribution in open-source or proprietary products. Distributions follow the Apache License and preserve applicable notice material.", links: [["Read LICENSE", "/LICENSE"], ["Read NOTICE", "/NOTICE"]] },
        { title: "Contributing", status: "Public repository", copy: "Development happens in public on GitHub. Review the architecture and contributor rules before proposing changes to simulation boundaries or public APIs.", links: [["Contribution guide", "https://github.com/PeiyuanQi/canwu/blob/main/CONTRIBUTING.md"], ["Repository", "https://github.com/PeiyuanQi/canwu"], ["Contributors", "https://github.com/PeiyuanQi/canwu/graphs/contributors"]] },
        { title: "Third-party software", status: "Repository notices", copy: "Engine and website dependencies retain their own licenses. The linked repository notices provide the authoritative inventories and complete detail.", links: [["Engine notices", "https://github.com/PeiyuanQi/canwu/blob/main/docs/legal/third-party-licenses.md"], ["Website notices", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"]] },
      ],
      privacyTitle: "Website privacy", privacy: ["Static pages with zero analytics requests", "No cookies; local and session storage are limited to tutorial UI preferences", "System-font stacks with zero third-party font requests", "Anonymous browsing with zero account or submission collection"],
      sourceTitle: "Website source", sourceCopy: "Website source, build scripts, bilingual page components, and the full tool inventory are maintained in website/ inside the main repository.",
      brandTitle: "Brand assets", brandCopy: "The site uses the official circular Canwu 35 mark documented in the repository brand guide. Its flying-white middle strokes suggest a double Li trigram motif without reproducing formal hexagram notation. Page diagrams and code panels are implemented with semantic HTML and CSS.",
      links: [["Website source", "https://github.com/PeiyuanQi/canwu/tree/main/website"], ["Website notices", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"], ["Brand guide", "https://github.com/PeiyuanQi/canwu/blob/main/docs/community/branding.md"]],
    }
  : {
      title: "参伍项目与网站说明",
      description: "参伍与 canwu.org 的许可证、贡献、第三方软件、隐私与项目说明。",
      label: "项目信息", heading: "许可、参与方式与网站鸣谢",
      intro: "参伍引擎与网站具有不同的依赖边界。本页为采用者和贡献者提供当前许可证文本、贡献规则、第三方声明与网站实现信息的直接入口。",
      trust: [
        { title: "引擎许可证", status: "开源 · Apache-2.0", copy: "Canwu 支持在开源或专有产品中免版税使用、修改和再分发。分发时遵守 Apache 许可证并保留适用的声明材料。", links: [["阅读 LICENSE", "/LICENSE"], ["阅读 NOTICE", "/NOTICE"]] },
        { title: "参与贡献", status: "公开仓库", copy: "开发工作在 GitHub 公开进行。提出涉及模拟边界或公开 API 的变更前，请先了解项目架构与贡献规则。", links: [["贡献指南", "https://github.com/PeiyuanQi/canwu/blob/main/CONTRIBUTING.md"], ["代码仓库", "https://github.com/PeiyuanQi/canwu"], ["贡献者", "https://github.com/PeiyuanQi/canwu/graphs/contributors"]] },
        { title: "第三方软件", status: "仓库声明", copy: "引擎与网站依赖继续使用各自许可证。完整清单与详细信息由所链接的仓库声明集中维护。", links: [["引擎声明", "https://github.com/PeiyuanQi/canwu/blob/main/docs/legal/third-party-licenses.md"], ["网站声明", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"]] },
      ],
      privacyTitle: "网站隐私", privacy: ["静态页面保持零分析请求", "不使用 Cookie；本地与会话存储仅保存教程界面偏好", "系统字体栈保持第三方字体请求量为零", "匿名浏览，账号与提交数据收集量为零"],
      sourceTitle: "网站源码", sourceCopy: "网站源码、构建脚本、中英文页面组件与完整工具清单均维护在主仓库的 website/ 目录中。",
      brandTitle: "品牌资产", brandCopy: "网站使用仓库品牌指南中记录的官方圆环参伍 35 标志。中段飞白形成双离卦意象，但并非正式六爻卦画。页面图表与代码面板由语义化 HTML 和 CSS 实现。",
      links: [["网站源码", "https://github.com/PeiyuanQi/canwu/tree/main/website"], ["网站声明", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"], ["品牌指南", "https://github.com/PeiyuanQi/canwu/blob/main/docs/community/branding.md"]],
    };
---

<BaseLayout title={c.title} description={c.description} locale={locale} zhPath="/credits/" enPath="/en/credits/">
  <section class="reference-hero page-width"><p>{c.label}</p><h1>{c.heading}</h1><span>{c.intro}</span></section>
  <section class="trust-grid page-width">{c.trust.map((item) => <article><code>{item.status}</code><h2>{item.title}</h2><p>{item.copy}</p><div class="reference-links">{item.links.map(([label, url]) => <a href={url}>{label} {url.startsWith("/") ? "→" : "↗"}</a>)}</div></article>)}</section>
  <section class="privacy-section page-width"><header><p>{c.privacyTitle}</p></header><ul class="technical-list">{c.privacy.map((item) => <li>{item}</li>)}</ul></section>
  <section class="implementation-grid page-width"><article><h2>{c.sourceTitle}</h2><p>{c.sourceCopy}</p><div class="reference-links">{c.links.map(([label, url]) => <a href={url}>{label} {url.startsWith("/") ? "→" : "↗"}</a>)}</div></article><article><h2>{c.brandTitle}</h2><p>{c.brandCopy}</p></article></section>
</BaseLayout>
