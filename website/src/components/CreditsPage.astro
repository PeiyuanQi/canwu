---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props { locale: "zh-CN" | "en"; }
const { locale } = Astro.props;
const isEnglish = locale === "en";

const c = isEnglish
  ? {
      title: "Canwu website implementation and credits",
      description: "Implementation, dependency, privacy, design-reference, license, and trademark notes for canwu.org.",
      label: "Website notes", heading: "Implementation and credits",
      intro: "canwu.org is a static Astro project deployed with GitHub Pages. This page records the direct tools and services used by the website; complete application dependency notices remain in the main repository.",
      privacyTitle: "Privacy", privacy: ["No analytics or tracking pixels", "No third-party hosted fonts", "No client-side application framework runtime", "Astro telemetry disabled in local and deployment scripts"],
      rows: [
        ["Astro 7", "Static site framework", "MIT", "https://astro.build/"],
        ["@astrojs/sitemap", "Sitemap generation", "MIT", "https://docs.astro.build/en/guides/integrations-guide/sitemap/"],
        ["@astrojs/check", "Astro and TypeScript validation", "MIT", "https://www.npmjs.com/package/@astrojs/check"],
        ["Vite", "Build pipeline used by Astro", "MIT", "https://vite.dev/"],
        ["TypeScript", "Type checking", "Apache-2.0", "https://www.typescriptlang.org/"],
        ["cross-env", "Cross-platform environment variables", "MIT", "https://github.com/kentcdodds/cross-env"],
        ["pnpm", "Package management", "MIT", "https://pnpm.io/"],
        ["GitHub Actions", "Automated build and deployment", "Service", "https://github.com/features/actions"],
        ["GitHub Pages", "Static hosting and TLS", "Service", "https://pages.github.com/"],
      ],
      columns: ["Project", "Use", "License / type"],
      designTitle: "Design reference", designCopy: "The revised information structure takes cues from Bevy and Godot: concise project identity, real code, direct documentation links, feature explanations, project status, and contribution paths. No copy, layout code, illustrations, or brand assets were reused.",
      assetsTitle: "Project assets", assetsCopy: "The website uses the official Canwu 35 mark from assets/branding. Layout, diagrams, and code panels are written in HTML and CSS. The site does not use generated hero art or a generated social card.",
      sourceTitle: "Source and notices", sourceCopy: "Website source lives in website/. The application license and third-party notices remain authoritative for Canwu itself.",
      legalTitle: "Trademarks", legalCopy: "Unity is a trademark of Unity Technologies. Unreal and Unreal Engine are trademarks or registered trademarks of Epic Games, Inc. Godot and Bevy names belong to their respective projects and rights holders. References do not imply endorsement, integration, or affiliation.",
      links: [["Website source", "https://github.com/PeiyuanQi/canwu/tree/main/website"], ["Website notices", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"], ["Canwu license", "https://github.com/PeiyuanQi/canwu/blob/main/LICENSE"], ["Application notices", "https://github.com/PeiyuanQi/canwu/blob/main/THIRD_PARTY_NOTICES.html"]],
    }
  : {
      title: "参伍网站实现与鸣谢",
      description: "canwu.org 的实现、依赖、隐私、设计参考、许可证与商标说明。",
      label: "网站说明", heading: "实现与鸣谢",
      intro: "canwu.org 是通过 GitHub Pages 部署的静态 Astro 项目。本页记录网站直接使用的工具与服务；参伍应用本身的完整依赖声明仍以主仓库文件为准。",
      privacyTitle: "隐私", privacy: ["无分析统计或跟踪像素", "无第三方托管字体", "不加载客户端应用框架运行时", "本地与部署脚本均关闭 Astro 遥测"],
      rows: [
        ["Astro 7", "静态网站框架", "MIT", "https://astro.build/"],
        ["@astrojs/sitemap", "站点地图生成", "MIT", "https://docs.astro.build/en/guides/integrations-guide/sitemap/"],
        ["@astrojs/check", "Astro 与 TypeScript 验证", "MIT", "https://www.npmjs.com/package/@astrojs/check"],
        ["Vite", "Astro 使用的构建管线", "MIT", "https://vite.dev/"],
        ["TypeScript", "类型检查", "Apache-2.0", "https://www.typescriptlang.org/"],
        ["cross-env", "跨平台环境变量", "MIT", "https://github.com/kentcdodds/cross-env"],
        ["pnpm", "软件包管理", "MIT", "https://pnpm.io/"],
        ["GitHub Actions", "自动构建与部署", "服务", "https://github.com/features/actions"],
        ["GitHub Pages", "静态托管与 TLS", "服务", "https://pages.github.com/"],
      ],
      columns: ["项目", "用途", "许可证 / 类型"],
      designTitle: "设计参考", designCopy: "新版信息结构参考 Bevy 与 Godot 的做法：简洁项目身份、真实代码、直接文档入口、功能说明、项目状态与贡献路径。没有复用任何文案、布局代码、插图或品牌资产。",
      assetsTitle: "项目资产", assetsCopy: "网站使用 assets/branding 中的官方参伍 35 标志。布局、图表与代码面板均由 HTML 和 CSS 编写。网站不使用生成式首图或生成式社交预览图。",
      sourceTitle: "源码与声明", sourceCopy: "网站源码位于 website/。参伍应用本身的许可证与第三方声明继续具有权威性。",
      legalTitle: "商标", legalCopy: "Unity 是 Unity Technologies 的商标。Unreal 与 Unreal Engine 是 Epic Games, Inc. 的商标或注册商标。Godot 与 Bevy 名称归各自项目及权利人所有。相关提及不表示背书、集成或隶属关系。",
      links: [["网站源码", "https://github.com/PeiyuanQi/canwu/tree/main/website"], ["网站声明", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"], ["Canwu 许可证", "https://github.com/PeiyuanQi/canwu/blob/main/LICENSE"], ["应用第三方声明", "https://github.com/PeiyuanQi/canwu/blob/main/THIRD_PARTY_NOTICES.html"]],
    };
---

<BaseLayout title={c.title} description={c.description} locale={locale} zhPath="/credits/" enPath="/en/credits/">
  <section class="reference-hero page-width"><p>{c.label}</p><h1>{c.heading}</h1><span>{c.intro}</span></section>

  <section class="privacy-section page-width"><header><p>{c.privacyTitle}</p></header><ul class="technical-list">{c.privacy.map((item) => <li>{item}</li>)}</ul></section>

  <section class="credit-table page-width"><header><span>{c.columns[0]}</span><span>{c.columns[1]}</span><span>{c.columns[2]}</span><span></span></header>{c.rows.map(([name, role, license, url]) => <a href={url}><code>{name}</code><span>{role}</span><small>{license}</small><b>↗</b></a>)}</section>

  <section class="implementation-grid page-width"><article><h2>{c.designTitle}</h2><p>{c.designCopy}</p><div class="reference-links"><a href="https://bevyengine.org/">Bevy ↗</a><a href="https://godotengine.org/">Godot ↗</a></div></article><article><h2>{c.assetsTitle}</h2><p>{c.assetsCopy}</p><a href="https://github.com/PeiyuanQi/canwu/blob/main/BRANDING.md">BRANDING.md ↗</a></article><article><h2>{c.sourceTitle}</h2><p>{c.sourceCopy}</p><div class="reference-links">{c.links.map(([label, url]) => <a href={url}>{label} ↗</a>)}</div></article><article><h2>{c.legalTitle}</h2><p>{c.legalCopy}</p></article></section>
</BaseLayout>
