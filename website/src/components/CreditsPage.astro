---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props { locale: "zh-CN" | "en"; }
const { locale } = Astro.props;
const isEnglish = locale === "en";

const c = isEnglish
  ? {
      title: "Canwu project and website information",
      description: "License, contribution, third-party software, privacy, and project information for Canwu and canwu.org.",
      label: "Project information", heading: "License, contributing, and credits",
      intro: "Licenses, contribution rules, third-party notices, and how this website is built. The engine and the website have separate dependencies, so each has its own notice file.",
      trust: [
        { title: "Engine license", status: "Open source · Apache-2.0", copy: "You may use, modify, and redistribute Canwu in open-source or proprietary products without royalties. Copies you distribute must include the Apache license and the relevant NOTICE material.", links: [["Read LICENSE", "/LICENSE"], ["Read NOTICE", "/NOTICE"]] },
        { title: "Contributing", status: "Public repository", copy: "Development happens in public on GitHub. Before proposing a change to simulation boundaries or the public API, read the architecture guide and the contribution rules.", links: [["Contribution guide", "https://github.com/PeiyuanQi/canwu/blob/main/CONTRIBUTING.md"], ["Repository", "https://github.com/PeiyuanQi/canwu"], ["Contributors", "https://github.com/PeiyuanQi/canwu/graphs/contributors"]] },
        { title: "Third-party software", status: "Repository notices", copy: "Engine and website dependencies keep their own licenses. The notice files below list them in full.", links: [["Engine notices", "https://github.com/PeiyuanQi/canwu/blob/main/docs/legal/third-party-licenses.md"], ["Website notices", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"]] },
      ],
      privacyTitle: "Website privacy", privacy: ["Static pages with no analytics", "No cookies; local and session storage hold only display state (color theme and docs sidebar position)", "System fonts only, with no third-party font requests", "No accounts, forms, or data collection"],
      sourceTitle: "Website source", sourceCopy: "The website source, build scripts, and page components for both languages live in the website/ folder of the main repository, together with the full list of tools the site uses.",
      brandTitle: "Brand assets", brandCopy: "The site uses the Canwu mark from the repository brand guide: a brush-written 35 (参伍, “three and five”) in a circular frame. Its dry-brush middle strokes suggest a doubled Li trigram as a modern brand motif. Diagrams on the site are drawn with HTML, CSS, and Mermaid.",
      links: [["Website source", "https://github.com/PeiyuanQi/canwu/tree/main/website"], ["Website notices", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"], ["Brand guide", "https://github.com/PeiyuanQi/canwu/blob/main/docs/community/branding.md"]],
    }
  : {
      title: "参伍项目与网站说明",
      description: "参伍与 canwu.org 的许可证、贡献、第三方软件、隐私与项目说明。",
      label: "项目信息", heading: "许可证、参与贡献与鸣谢",
      intro: "这里汇总许可证、贡献规则、第三方声明，以及本网站的构建方式。引擎与网站的依赖各自独立，因此各有一份声明文件。",
      trust: [
        { title: "引擎许可证", status: "开源 · Apache-2.0", copy: "你可以在开源或专有产品中免版税地使用、修改和再分发参伍。分发副本时须附带 Apache 许可证及相应的 NOTICE 材料。", links: [["阅读 LICENSE", "/LICENSE"], ["阅读 NOTICE", "/NOTICE"]] },
        { title: "参与贡献", status: "公开仓库", copy: "开发在 GitHub 上公开进行。提议修改模拟边界或对外 API 之前，请先阅读架构指南和贡献规则。", links: [["贡献指南", "https://github.com/PeiyuanQi/canwu/blob/main/CONTRIBUTING.md"], ["代码仓库", "https://github.com/PeiyuanQi/canwu"], ["贡献者", "https://github.com/PeiyuanQi/canwu/graphs/contributors"]] },
        { title: "第三方软件", status: "仓库声明", copy: "引擎和网站的依赖各自沿用原有许可证，完整清单见下方的声明文件。", links: [["引擎声明", "https://github.com/PeiyuanQi/canwu/blob/main/docs/legal/third-party-licenses.md"], ["网站声明", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"]] },
      ],
      privacyTitle: "网站隐私", privacy: ["静态页面，没有任何统计分析", "不使用 Cookie；本地存储和会话存储只保存显示状态（配色主题和文档侧边栏位置）", "只使用系统字体，不请求第三方字体", "没有账号、表单或数据收集"],
      sourceTitle: "网站源码", sourceCopy: "网站源码、构建脚本和中英文页面组件都在主仓库的 website/ 目录中，其中也列出了网站使用的全部工具。",
      brandTitle: "品牌资产", brandCopy: "网站使用仓库品牌指南中介绍的圆环参伍 35 标志。标志中段的飞白笔画形成双离卦意象，是一种现代品牌诠释。网站中的图表使用 HTML、CSS 与 Mermaid 绘制。",
      links: [["网站源码", "https://github.com/PeiyuanQi/canwu/tree/main/website"], ["网站声明", "https://github.com/PeiyuanQi/canwu/blob/main/website/THIRD_PARTY_NOTICES.md"], ["品牌指南", "https://github.com/PeiyuanQi/canwu/blob/main/docs/community/branding.md"]],
    };
---

<BaseLayout title={c.title} description={c.description} locale={locale} zhPath="/credits/" enPath="/en/credits/">
  <section class="reference-hero page-width"><p>{c.label}</p><h1>{c.heading}</h1><span>{c.intro}</span></section>
  <section class="trust-grid page-width">{c.trust.map((item) => <article><code>{item.status}</code><h2>{item.title}</h2><p>{item.copy}</p><div class="reference-links">{item.links.map(([label, url]) => <a href={url}>{label} {url.startsWith("/") ? "→" : "↗"}</a>)}</div></article>)}</section>
  <section class="privacy-section page-width"><header><p>{c.privacyTitle}</p></header><ul class="technical-list">{c.privacy.map((item) => <li>{item}</li>)}</ul></section>
  <section class="implementation-grid page-width"><article><h2>{c.sourceTitle}</h2><p>{c.sourceCopy}</p><div class="reference-links">{c.links.map(([label, url]) => <a href={url}>{label} {url.startsWith("/") ? "→" : "↗"}</a>)}</div></article><article><h2>{c.brandTitle}</h2><p>{c.brandCopy}</p></article></section>
</BaseLayout>
