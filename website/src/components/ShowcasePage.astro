---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props { locale: "zh-CN" | "en"; }
const { locale } = Astro.props;
const isEnglish = locale === "en";

const c = isEnglish
  ? {
      title: "Canwu use cases and integration patterns",
      description: "Technical responsibility and API notes for game, research, agent, and educational Canwu clients.",
      label: "Integration notes",
      heading: "Use cases and client responsibilities",
      intro: "Canwu is the authoritative simulation layer. Rendering, authentication, orchestration, datasets, and product UI remain outside the engine. The notes below describe that boundary for common client types.",
      index: "Sections",
      canwuOwns: "Canwu is responsible for",
      clientOwns: "External client is responsible for",
      relevant: "Relevant interfaces",
      cases: [
        { id: "games", number: "01", kind: "Games", title: "Grand strategy and persistent worlds", purpose: "Use Canwu as the server-side or embedded authority beneath a map, renderer, and player interface.", canwu: ["Simulation time and deterministic scheduling", "Validated commands and attributable events", "Actor-relative knowledge and delayed information", "Plugin-owned historical state and records"], client: ["2D or 3D rendering", "Input, menus, saves UI, and localization", "Network transport and account authentication", "Scenario data, art, audio, and production content"], api: ["process_command", "advance / settle_boundary", "snapshot", "events", "query_as"] },
        { id: "research", number: "02", kind: "Research", title: "Historical process experiments", purpose: "Run reproducible scenarios, retain evidence, and compare counterfactual branches without coupling analysis to a game UI.", canwu: ["Deterministic run configuration", "Snapshots, forks, diffs, and replay", "Causal event and random-draw journals", "Plugin manifests and state commitments"], client: ["Research question and model design", "Source datasets and provenance policy", "Statistical analysis and validation", "Charts, notebooks, maps, and publication output"], api: ["snapshot_json", "fork", "diff", "replay_with_plugins", "world"] },
        { id: "agents", number: "03", kind: "Agents", title: "Multi-agent historical environments", purpose: "Give each agent a stable action loop while keeping its observations inside the represented actor's knowledge and authority.", canwu: ["Capability and action discovery", "Actor-relative observations", "Action validation and authority context", "Causal explanations of resulting events"], client: ["Model selection and orchestration", "Authentication before selecting an issuer", "Prompting and conversation state", "Rate limits, transport, and deployment"], api: ["describe_capabilities", "observe", "available_actions", "act", "explain", "wait"] },
        { id: "education", number: "04", kind: "Education", title: "Classroom and public-history tools", purpose: "Expose historical systems through timelines, maps, exhibits, or guided scenarios while retaining repeatable simulation state.", canwu: ["Scenario state and historical time", "Multiple perspectives on the same world", "Repeatable interventions and replay", "Causal records for explanation"], client: ["Curriculum and interpretation", "Accessible interaction design", "Museum hardware or web presentation", "Editorial text, media, and citations"], api: ["observe", "inspect", "query_as", "snapshot", "fork", "explain"] },
      ],
      next: "Start from the public boundary",
      nextCopy: "If a client needs a read or action the public API cannot express, improve canwu-api instead of reaching into simulation internals.",
      architecture: "Architecture documentation",
      example: "API examples",
    }
  : {
      title: "参伍应用方向与集成方式",
      description: "参伍游戏、研究、智能体与教育客户端的技术职责和 API 说明。",
      label: "集成说明",
      heading: "应用方向与客户端职责",
      intro: "参伍是权威模拟层。渲染、认证、编排、数据集与产品界面位于引擎之外。以下内容说明常见客户端类型如何划分这条边界。",
      index: "章节",
      canwuOwns: "参伍负责",
      clientOwns: "外部客户端负责",
      relevant: "相关接口",
      cases: [
        { id: "games", number: "01", kind: "游戏", title: "大战略与持续世界", purpose: "将参伍作为地图、渲染器与玩家界面之下的服务端或嵌入式权威。", canwu: ["模拟时间与确定性调度", "经验证命令与可归因事件", "角色视角知识与延迟信息", "插件拥有的历史状态与记录"], client: ["二维或三维渲染", "输入、菜单、存档界面与本地化", "网络传输与账号认证", "场景数据、美术、音频与正式内容"], api: ["process_command", "advance / settle_boundary", "snapshot", "events", "query_as"] },
        { id: "research", number: "02", kind: "研究", title: "历史过程实验", purpose: "运行可重复场景、保留证据并比较反事实分支，同时不把分析工作绑定到游戏界面。", canwu: ["确定性运行配置", "快照、分支、差异与重演", "因果事件与随机抽取日志", "插件清单与状态承诺"], client: ["研究问题与模型设计", "来源数据集与溯源政策", "统计分析与验证", "图表、笔记本、地图与出版输出"], api: ["snapshot_json", "fork", "diff", "replay_with_plugins", "world"] },
        { id: "agents", number: "03", kind: "智能体", title: "多智能体历史环境", purpose: "为每个智能体提供稳定行动循环，同时把观察限制在所代表角色的知识与权限内。", canwu: ["能力与行动发现", "角色视角观察", "行动验证与权限上下文", "结果事件的因果解释"], client: ["模型选择与编排", "选择 Issuer 之前的身份认证", "提示词与对话状态", "限流、传输与部署"], api: ["describe_capabilities", "observe", "available_actions", "act", "explain", "wait"] },
        { id: "education", number: "04", kind: "教育", title: "课堂与公共史工具", purpose: "通过时间线、地图、展览或引导场景呈现历史系统，同时保留可重复的模拟状态。", canwu: ["场景状态与历史时间", "同一世界的多重视角", "可重复干预与重演", "用于解释的因果记录"], client: ["课程与历史解释", "无障碍交互设计", "博物馆硬件或网页表现", "编辑文本、媒体与引文"], api: ["observe", "inspect", "query_as", "snapshot", "fork", "explain"] },
      ],
      next: "从公开边界开始",
      nextCopy: "如果客户端需要的读取或行动无法通过公开 API 表达，应改进 canwu-api，而不是绕过边界访问模拟内部。",
      architecture: "架构文档",
      example: "API 示例",
    };
---

<BaseLayout title={c.title} description={c.description} locale={locale} zhPath="/showcase/" enPath="/en/showcase/">
  <section class="reference-hero page-width">
    <p>{c.label}</p><h1>{c.heading}</h1><span>{c.intro}</span>
    <nav aria-label={c.index}>{c.cases.map((item) => <a href={`#${item.id}`}><code>{item.number}</code>{item.title}</a>)}</nav>
  </section>

  <div class="integration-list">
    {c.cases.map((item) => (
      <section class="integration-case page-width" id={item.id}>
        <header><code>{item.number}</code><p>{item.kind}</p><h2>{item.title}</h2><span>{item.purpose}</span></header>
        <div class="responsibility-grid">
          <article><h3>{c.canwuOwns}</h3><ul class="technical-list">{item.canwu.map((entry) => <li>{entry}</li>)}</ul></article>
          <article><h3>{c.clientOwns}</h3><ul class="technical-list">{item.client.map((entry) => <li>{entry}</li>)}</ul></article>
        </div>
        <div class="api-strip"><span>{c.relevant}</span><div>{item.api.map((name) => <code>{name}</code>)}</div></div>
      </section>
    ))}
  </div>

  <section class="reference-footer page-width"><div><p>{c.next}</p><h2>{c.nextCopy}</h2></div><div><a class="button primary" href="https://github.com/PeiyuanQi/canwu/blob/main/docs/architecture.md">{c.architecture} ↗</a><a class="button" href="https://github.com/PeiyuanQi/canwu/tree/main/crates/canwu-api/examples">{c.example} ↗</a></div></section>
</BaseLayout>
