---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props { locale: "zh-CN" | "en"; }
const { locale } = Astro.props;
const isEnglish = locale === "en";

const c = isEnglish
  ? {
      title: "Canwu Showcases — Games, research, agents, and public history",
      description: "Explore the games, research simulations, agent worlds, and educational experiences that Canwu is designed to support.",
      eyebrow: "Application atlas", headline: "One history engine.", headlineEm: "Many ways in.",
      intro: "Canwu keeps the simulation authoritative and the presentation replaceable. These are design territories, not locked templates: combine them, extend them, or build a client category that does not exist yet.",
      navAria: "Showcase categories", presentation: "Presentation layer", closingKicker: "BUILD YOUR ADAPTER", closing: "The world is authoritative.", closingEm: "The view is yours.", start: "Start from the repository ↗", study: "Study the architecture ↗",
      categories: [
        { id: "case-1", number: "01", eyebrow: "Games", title: "Grand strategy worlds", lead: "Model the world beneath the map: commands, delayed knowledge, scheduled consequences, institutions, and competing systems that settle in a repeatable order.", examples: [["Dynastic strategy", "Succession, offices, obligations, factions, and incomplete intelligence across generations."], ["Campaign simulation", "Movement, logistics, command delay, reconnaissance, and causally attributable outcomes."], ["Persistent worlds", "A headless authority that can keep simulating while any client, map, or renderer connects."]], presentation: "Render with a 2D map, a 3D engine, a browser, a terminal, or several clients at once." },
        { id: "case-2", number: "02", eyebrow: "Research", title: "Historical process laboratories", lead: "Turn assumptions into inspectable plugins, run repeatable scenarios, fork the timeline, and compare outcomes without losing the event evidence that produced them.", examples: [["Counterfactual studies", "Fork from a snapshot, change one decision or rule set, then diff resulting worlds."], ["Institutional models", "Represent period-specific records and transitions without hard-coding one region into the kernel."], ["Reproducible experiments", "Use deterministic random streams, manifests, journals, and state commitments."]], presentation: "Present results as notebooks, dashboards, maps, network diagrams, or archived datasets." },
        { id: "case-3", number: "03", eyebrow: "Agents", title: "Multi-agent historical worlds", lead: "Give agents a stable semantic interface across scenarios while keeping each one inside the knowledge, authority, and actions of the actor it represents.", examples: [["Diplomacy sandboxes", "Agents negotiate and act from different seats with different information."], ["Decision evaluation", "Measure choices against legal actions, causal outcomes, and actor-visible evidence."], ["Narrative participants", "Let characters inspect, act, wait, and explain without direct access to ground truth."]], presentation: "Connect orchestration systems, local models, hosted agents, or human-agent mixed interfaces." },
        { id: "case-4", number: "04", eyebrow: "Learning & public history", title: "Explorable historical systems", lead: "Let learners see how information age, uncertainty, institutions, and delayed consequences change decisions—not just read the final date in a timeline.", examples: [["Museum interactives", "Drive touch tables, projected maps, spatial installations, or guided exhibits."], ["Classroom sandboxes", "Replay a scenario, test an intervention, and discuss the recorded chain of causes."], ["Living archives", "Connect structured records to an explorable world model and multiple perspectives."]], presentation: "Use accessible web experiences, installations, classroom tools, or narrated data stories." },
      ],
    }
  : {
      title: "参伍应用场景 — 游戏、研究、智能体与公共史",
      description: "探索参伍可支持的大战略游戏、历史研究模拟、多智能体世界与教育体验。",
      eyebrow: "应用图谱", headline: "一台历史引擎。", headlineEm: "多种进入方式。",
      intro: "参伍让模拟保持权威，让表现层保持可替换。这里展示的是可组合、可扩展的设计方向，而不是锁死的模板；你也可以创造尚不存在的客户端类型。",
      navAria: "应用场景分类", presentation: "表现层", closingKicker: "构建你的适配器", closing: "世界保持权威。", closingEm: "视角属于你。", start: "从代码仓库开始 ↗", study: "研究架构文档 ↗",
      categories: [
        { id: "case-1", number: "01", eyebrow: "游戏", title: "大战略世界", lead: "模拟地图之下的世界：命令、延迟情报、定时后果、制度，以及按确定顺序结算的竞争系统。", examples: [["王朝战略", "跨越世代模拟继承、官职、义务、派系与不完整情报。"], ["战役模拟", "处理移动、补给、指挥延迟、侦察与可追溯因果的结果。"], ["持续世界", "由无头权威持续推进模拟，地图、渲染器与多个客户端可随时连接。"]], presentation: "使用二维地图、三维引擎、浏览器、终端，或让多个客户端同时呈现。" },
        { id: "case-2", number: "02", eyebrow: "研究", title: "历史过程实验室", lead: "把假设写成可检查的插件，运行可重复场景，分叉时间线并比较结果，同时保留产生结果的事件证据。", examples: [["反事实研究", "从快照分叉，只改变一个决策或规则集，再比较两个世界。"], ["制度模型", "表达特定时代的记录与转变，而不把某一地区硬编码进内核。"], ["可重复实验", "使用确定性随机流、清单、日志与状态承诺。"]], presentation: "将结果呈现为笔记本、仪表盘、地图、网络图或可归档数据集。" },
        { id: "case-3", number: "03", eyebrow: "智能体", title: "多智能体历史世界", lead: "为不同场景提供稳定的语义接口，同时把每个智能体限制在其角色拥有的知识、权限与行动范围内。", examples: [["外交沙盒", "智能体在不同席位、不同信息条件下协商并行动。"], ["决策评估", "依据合法行动、因果结果与角色可见证据衡量选择。"], ["叙事参与者", "让角色检查、行动、等待并解释，而不是直接读取世界真相。"]], presentation: "连接编排系统、本地模型、托管智能体，或人机混合界面。" },
        { id: "case-4", number: "04", eyebrow: "教育与公共史", title: "可探索的历史系统", lead: "让学习者看到信息时效、不确定性、制度与延迟后果如何改变决策，而不只是阅读时间线上的最终日期。", examples: [["博物馆交互", "驱动触控桌、投影地图、空间装置或引导式展览。"], ["课堂沙盒", "重演场景、测试干预，并围绕记录下来的因果链展开讨论。"], ["活档案", "把结构化记录连接到可探索的世界模型与多重视角。"]], presentation: "使用无障碍网页体验、展览装置、课堂工具或叙事型数据作品。" },
      ],
    };
---

<BaseLayout title={c.title} description={c.description} locale={locale} zhPath="/showcase/" enPath="/en/showcase/">
  <section class="page-hero showcase-hero">
    <p class="eyebrow"><span></span> {c.eyebrow}</p><h1>{c.headline}<br /><em>{c.headlineEm}</em></h1>
    <div class="page-hero-grid"><p>{c.intro}</p><nav class="section-index" aria-label={c.navAria}>{c.categories.map((category) => <a href={`#${category.id}`}><span>{category.number}</span>{category.title}</a>)}</nav></div>
  </section>
  <div class="showcase-list">{c.categories.map((category) => <section class="showcase-case section-wide" id={category.id} aria-labelledby={`${category.id}-title`}><header><span>{category.number}</span><p>{category.eyebrow}</p><h2 id={`${category.id}-title`}>{category.title}</h2><p class="case-lead">{category.lead}</p></header><div class="case-body"><div class="case-examples">{category.examples.map(([title, copy]) => <article><h3>{title}</h3><p>{copy}</p></article>)}</div><aside><span>{c.presentation}</span><p>{category.presentation}</p></aside></div></section>)}</div>
  <section class="closing-cta section-wide"><p>{c.closingKicker}</p><h2>{c.closing}<br /><em>{c.closingEm}</em></h2><div><a class="button button-primary" href="https://github.com/PeiyuanQi/canwu">{c.start}</a><a class="button button-secondary" href="https://github.com/PeiyuanQi/canwu/blob/main/docs/architecture.md">{c.study}</a></div></section>
</BaseLayout>
