---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props { locale: "zh-CN" | "en"; }
const { locale } = Astro.props;
const isEnglish = locale === "en";
const apiSource = "https://github.com/PeiyuanQi/canwu/blob/main/crates/api/canwu-api/src/lib.rs";
const starterSource = "https://github.com/PeiyuanQi/canwu/blob/main/crates/integrations/canwu-reference-world/examples/starter.rs";

const commonCases = [
  {
    id: "games", number: "01", api: ["enqueue_command", "advance_canonical", "typed_domain_record", "events"],
    proof: `canwu.enqueue_command(time, priority, request)?;
canwu.advance_canonical(SimDuration::hours(1))?;
let record = canwu.typed_domain_record(&game_state_ref); // Option<&DomainRecord>
let events = canwu.events();`,
  },
  {
    id: "research", number: "02", api: ["snapshot_json", "fork", "replay_journal", "replay_from_journal", "checkpoint_hash"],
    proof: `let saved = canwu.snapshot_json()?;
let branch = canwu.fork();
let journal = canwu.replay_journal();
let replayed = Canwu::replay_from_journal(plugins, &journal)?;
assert_eq!(replayed.checkpoint_hash(), canwu.checkpoint_hash());`,
  },
  {
    id: "agents", number: "03", api: ["viewer_for_actor", "query_knowledge", "visible_changes_since", "evaluation_traces", "enqueue_command"],
    proof: `let view = canwu.viewer_for_actor(actor)?.query_knowledge(&query)?;
canwu.enqueue_command(time, priority, request)?;
canwu.advance_canonical(duration)?;
let changes = canwu.viewer_for_actor(actor)?.visible_changes_since(time);`,
  },
  {
    id: "education", number: "04", api: ["entities", "events", "snapshot_json", "fork", "explain"],
    proof: `entities()        → stable identities
domain projection → timeline or map state
events()          → causal history
fork()            → what-if branch`,
  },
];

const localized = isEnglish
  ? {
      title: "Canwu integration patterns",
      description: "How games, research tools, agent environments, and public-history projects divide the work with Canwu.",
      label: "Integration patterns",
      heading: "One simulation engine, four kinds of application",
      intro: "Canwu handles simulation time, entities, commands, events, saves, and replay. Domain plugins supply the rules and typed commands for a period. Your application supplies presentation, accounts, orchestration, and content. Each pattern lists what Canwu provides, what you build, and what is still open for contributions.",
      index: "Patterns", available: "Canwu provides", client: "You build", notIncluded: "Open for contributions", relevant: "Main API calls", evidence: "Code shape",
      cases: [
        { kind: "Games", status: "APIs available", title: "Grand strategy and persistent worlds", purpose: "Run Canwu inside the game process or behind a server, and keep your world rules in a plugin.", available: ["Deterministic time, independent of frame rate", "Command ingress and causal events", "Entity and domain-record registries", "Plugin-owned typed state, settled at boundaries"], client: ["2D or 3D rendering and input", "Menus, save screens, localization, and accessibility", "Networking, accounts, and authentication", "Scenarios, art, audio, and game content"], missing: ["Renderer adapters", "Multiplayer services", "Complete playable campaigns"] },
        { kind: "Research", status: "Fork and replay available", title: "Reproducible scenarios and alternative histories", purpose: "Keep runs independent of your notebooks and charts, then compare alternative histories branched with fork().", available: ["Validated snapshots and checkpoint hashes", "Fork and exact replay", "Causal events and a journal of random draws", "Plugin manifests and version identities"], client: ["Research questions and model design", "Source data and provenance rules", "Statistical validation and interpretation", "Notebooks, maps, charts, and publications"], missing: ["Curated historical datasets", "Statistical analysis packages", "Frameworks for validating historical models"] },
        { kind: "Agents", status: "Per-character loop available", title: "Multi-agent historical environments", purpose: "Give each model a view limited to its character, and send its typed decisions through the same command path as players.", available: ["Viewers tied to the character an agent plays", "Knowledge queries that return only what that character knows", "Issuer and revision checks on every command", "Rule explanations limited to what the character knows"], client: ["Model choice and orchestration", "Authentication before an agent is assigned an issuer", "Prompts, memory, and conversation state", "Rate limits, transport, evaluation, and deployment"], missing: ["Hosted agent services", "Model and prompt frameworks", "Application authorization policy"] },
        { kind: "Education", status: "APIs available", title: "Classroom and public-history tools", purpose: "Put replayable simulation state behind a timeline, map, exhibit, or guided classroom scenario.", available: ["Historical time and stable entity identity", "Projections supplied by domain integrations", "Repeatable what-if changes through snapshots and forks", "Causal records that explain what happened"], client: ["Curriculum, interpretation, and citations", "Accessible interaction and editorial design", "Museum hardware or web presentation", "Media rights, localization, and facilitation"], missing: ["Maintained teaching applications", "Curriculum packages and museum installations", "Checks against education standards"] },
      ],
      next: "Start with runnable code", nextCopy: "Run the reference example first, then use the architecture guide to decide which rules belong in a plugin and which belong in your client.", run: "View starter source", architecture: "Read the architecture", source: "Open API source",
    }
  : {
      title: "参伍集成模式",
      description: "游戏、研究工具、智能体环境和公众史学项目如何与参伍分工。",
      label: "集成模式", heading: "同一个模拟引擎，四类应用",
      intro: "参伍负责模拟时间、实体、命令、事件、存档与重放。领域插件提供特定时代的规则和类型化命令。你的应用负责表现、账号、编排与内容。下面每种模式都列出参伍已经提供的能力、需要你构建的部分，以及欢迎社区共建的部分。",
      index: "模式", available: "参伍提供", client: "你来构建", notIncluded: "欢迎共建", relevant: "主要 API", evidence: "代码形态",
      cases: [
        { kind: "游戏", status: "API 已可用", title: "大战略与持久世界", purpose: "参伍可以运行在游戏进程内，也可以部署在服务端；世界规则写在插件中。", available: ["确定性时间，与画面帧率无关", "命令输入与因果事件", "实体与领域记录注册表", "由插件拥有、在边界中结算的类型化状态"], client: ["二维或三维渲染与输入", "菜单、存档界面、本地化与无障碍", "网络、账号与身份认证", "场景、美术、音频与游戏内容"], missing: ["渲染器适配器", "多人联机服务", "完整可玩的战役"] },
        { kind: "研究", status: "派生分支与重放已可用", title: "可复现实验与平行现实", purpose: "让模拟运行独立于计算笔记本和图表，再比较通过 fork() 派生出的多个平行现实。", available: ["经验证的快照与检查点哈希", "派生分支与精确重放", "因果事件与随机抽样日志", "插件清单与版本身份"], client: ["研究问题与模型设计", "来源数据与溯源规则", "统计验证与历史解释", "计算笔记本、地图、图表与出版物"], missing: ["整理好的历史数据集", "统计分析软件包", "历史模型验证框架"] },
        { kind: "智能体", status: "按角色视角的智能体循环已可用", title: "多智能体历史环境", purpose: "为每个模型提供限定在其角色范围内的视图，并让它的类型化决策与玩家走同一条命令路径。", available: ["与智能体所扮演角色绑定的观察者", "只返回该角色所知内容的知识查询", "每条命令都检查签发者与修订版本", "只含该角色所知范围的规则说明"], client: ["模型选择与编排", "为智能体指定签发者之前的身份认证", "提示词、记忆与对话状态", "限流、传输、评测与部署"], missing: ["托管式智能体服务", "模型与提示词框架", "应用授权策略"] },
        { kind: "教育", status: "API 已可用", title: "课堂与公众史学工具", purpose: "在时间线、地图、展览或课堂引导场景背后使用可重放的模拟状态。", available: ["历史时间与稳定的实体身份", "由领域整合提供的投影", "通过快照与派生分支做可重复的“如果”推演", "用于解释经过的因果记录"], client: ["课程、历史解释与引文", "无障碍交互与编辑设计", "博物馆硬件或网页呈现", "媒体版权、本地化与教学组织"], missing: ["持续维护的教学应用", "课程包与博物馆装置", "教育标准对照"] },
      ],
      next: "先运行代码", nextCopy: "先运行参考示例，再借助架构指南决定哪些规则写进插件、哪些留在客户端。", run: "查看 starter 源码", architecture: "阅读架构", source: "打开 API 源码",
    };

const c = { ...localized, cases: localized.cases.map((item, index) => ({ ...commonCases[index], ...item })) };
---

<BaseLayout title={c.title} description={c.description} locale={locale} zhPath="/showcase/" enPath="/en/showcase/">
  <section class="reference-hero page-width">
    <p>{c.label}</p><h1>{c.heading}</h1><span>{c.intro}</span>
    <nav aria-label={c.index}>{c.cases.map((item) => <a href={`#${item.id}`}><code>{item.number}</code>{item.title}</a>)}</nav>
  </section>

  <div class="integration-list">
    {c.cases.map((item) => (
      <section class="integration-case page-width" id={item.id}>
        <header><code>{item.number}</code><p>{item.kind} · {item.status}</p><h2>{item.title}</h2><span>{item.purpose}</span></header>
        <div class="integration-details">
          <div class="responsibility-grid three"><article><h3>{c.available}</h3><ul class="technical-list">{item.available.map((entry) => <li>{entry}</li>)}</ul></article><article><h3>{c.client}</h3><ul class="technical-list">{item.client.map((entry) => <li>{entry}</li>)}</ul></article><article><h3>{c.notIncluded}</h3><ul class="technical-list">{item.missing.map((entry) => <li>{entry}</li>)}</ul></article></div>
          <div class="integration-proof"><div><span>{c.evidence}</span><pre><code>{item.proof}</code></pre></div><div class="api-strip"><span>{c.relevant}</span><div>{item.api.map((name) => <a href={apiSource}><code>{name}()</code></a>)}</div></div></div>
        </div>
      </section>
    ))}
  </div>

  <section class="reference-footer page-width"><div><p>{c.next}</p><h2>{c.nextCopy}</h2><div class="inline-command"><code>cargo run -p canwu-reference-world --example starter</code></div></div><div><a class="button primary" href={starterSource}>{c.run} ↗</a><a class="button" href={`${isEnglish ? "/en" : ""}/architecture/`}>{c.architecture} →</a><a class="text-action" href={apiSource}>{c.source} ↗</a></div></section>
</BaseLayout>
